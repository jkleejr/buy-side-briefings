# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor / IDE — local preferences, not the project's
.vscode/
.idea/
*.swp

# Claude Code — worktrees are local scratch, never part of the project.
# They live inside the repo, so without this every session's worktree shows up
# as untracked forever: pulling can't clear it, because it never came from the
# remote. (.claude/settings.local.json is already covered by *.local.json.)
.claude/worktrees/

# scratch
/tmp/
*.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
